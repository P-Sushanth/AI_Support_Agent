# Ignore *.jsonl by default EXCEPT golden set & human eval
*.jsonl
!data/golden/golden_set.jsonl
!data/human_eval/human_spot_checks.jsonl

# Ignore root markdown files EXCEPT README.md
/*.md
!README.md

# Allow docs directory and markdown files inside docs/
!docs/
!docs/*.md

